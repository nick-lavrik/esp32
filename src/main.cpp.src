// --- Колір "карток" (напівпрозорий вигляд, темний, щоб текст читався) ---
#define CARD_COLOR 0x10A2  // темно-синьо-сірий відтінок

bool tft_output(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t* bitmap) {
  img.pushImage(x, y, w, h, bitmap);
  return true;
}

void drawJpgBackground() {
  TJpgDec.setJpgScale(1);
  TJpgDec.setCallback(tft_output);

  if (TJpgDec.drawFsJpg(0, 0, "/space-03.jpg", LittleFS) != JDR_OK) {
    Serial.println("JPEG decode failed, filling black instead");
    img.fillScreen(TFT_YELLOW);
  }
}

