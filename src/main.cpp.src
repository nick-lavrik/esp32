#include "wifi.h"

const char* ntpServer1 = "1.pool.ntp.org";
const char* ntpServer2 = "ua.pool.ntp.org";
const char* ntpServer3 = "pool.ntp.org";
const long  gmtOffset_sec = 2 * 3600;
const int   daylightOffset_sec = 3600;

// --- Пінг ---
const char* pingHost = "8.8.8.8";
#define PING_INTERVAL_MS 1000
#define GRAPH_POINTS 100
int pingHistory[GRAPH_POINTS];
int pingHistoryIndex = 0;
bool pingHistoryFull = false;
uint32_t lastPingMs = 0;
int currentPing = -1; // -1 = timeout/помилка
int minPing = 9999, maxPing = 0;
long pingSum = 0;
int pingCount = 0;

// --- Тач ---
#define TOUCH_CS   33
#define TOUCH_IRQ  36
SPIClass touchSPI(HSPI);
XPT2046_Touchscreen ts(TOUCH_CS, TOUCH_IRQ);

// --- Підсвітка + світловий сенсор ---
#define TFT_BL_PIN TFT_BL
#define LIGHT_SENSOR_PIN 34

void setupBacklight() { pinMode(TFT_BL_PIN, OUTPUT); }
void setBrightness(uint8_t b) { analogWrite(TFT_BL_PIN, b); }

int readLightPercent() {
  int raw = analogRead(LIGHT_SENSOR_PIN);
  return constrain(map(raw, 1500, 0, 0, 100), 0, 100);
}

// --- Метрики "здоров'я" системи ---
uint32_t loopCounter = 0;
uint32_t loopsPerSecond = 0;
uint32_t lastLoopCheckMs = 0;

// --- Кольори UI ---
// #define BG_COLOR      TFT_BLACK
#define BG_COLOR      TFT_TRANSPARENT
#define GRID_COLOR    0x2104   // темно-сірий
#define GRAPH_COLOR   TFT_GREEN
#define GRAPH_BAD     TFT_RED
#define TEXT_MAIN     TFT_WHITE
#define TEXT_DIM      TFT_DARKGREY

// --- Геометрія графіка (екран 320x240, rotation=1) ---
#define GRAPH_X 10
#define GRAPH_Y 100
#define GRAPH_W 300
#define GRAPH_H 90
#define GRAPH_MAX_MS 200 // верхня межа шкали (мс) для автомасштабування відображення

void doPing() {
  bool success = Ping.ping(pingHost, 1);
  if (success) {
    currentPing = Ping.averageTime();
    if (currentPing < minPing) minPing = currentPing;
    if (currentPing > maxPing) maxPing = currentPing;
    pingSum += currentPing;
    pingCount++;
  } else {
    currentPing = -1; // timeout
  }

  pingHistory[pingHistoryIndex] = currentPing;
  pingHistoryIndex = (pingHistoryIndex + 1) % GRAPH_POINTS;
  if (pingHistoryIndex == 0) pingHistoryFull = true;
}

void drawGraphFrame() {

  // img.fillScreen(BG_COLOR);
  img.setTextSize(2);
  img.setTextColor(TEXT_MAIN);
  img.setCursor(10, 8);
  img.print("Network Pulse");

  img.drawRect(GRAPH_X, GRAPH_Y, GRAPH_W, GRAPH_H, GRID_COLOR);
  // Горизонтальні лінії-орієнтири (25/50/75/100 мс)
  for (int ms = 50; ms < GRAPH_MAX_MS; ms += 50) {
    int y = GRAPH_Y + GRAPH_H - (ms * GRAPH_H / GRAPH_MAX_MS);
    img.drawFastHLine(GRAPH_X, y, GRAPH_W, GRID_COLOR);
  }
}

void drawPingGraph() {

  int count = pingHistoryFull ? GRAPH_POINTS : pingHistoryIndex;
  if (count < 2) return;

  int startIdx = pingHistoryFull ? pingHistoryIndex : 0;

  // img.fillRect(GRAPH_X + 1, GRAPH_Y + 1, GRAPH_W - 2, GRAPH_H - 2, BG_COLOR);

  for (int i = 0; i < count - 1; i++) {
    int idx1 = (startIdx + i) % GRAPH_POINTS;
    int idx2 = (startIdx + i + 1) % GRAPH_POINTS;

    int v1 = pingHistory[idx1];
    int v2 = pingHistory[idx2];

    int x1 = GRAPH_X + (i * GRAPH_W / GRAPH_POINTS);
    int x2 = GRAPH_X + ((i + 1) * GRAPH_W / GRAPH_POINTS);

    uint16_t color1 = (v1 < 0) ? GRAPH_BAD : GRAPH_COLOR;
    uint16_t color2 = (v2 < 0) ? GRAPH_BAD : GRAPH_COLOR;

    int y1 = (v1 < 0) ? GRAPH_Y + GRAPH_H - 2
                       : GRAPH_Y + GRAPH_H - constrain(v1 * GRAPH_H / GRAPH_MAX_MS, 0, GRAPH_H - 1);
    int y2 = (v2 < 0) ? GRAPH_Y + GRAPH_H - 2
                       : GRAPH_Y + GRAPH_H - constrain(v2 * GRAPH_H / GRAPH_MAX_MS, 0, GRAPH_H - 1);

    img.drawLine(x1, y1, x2, y2, (v1 < 0 || v2 < 0) ? GRAPH_BAD : GRAPH_COLOR);
  }

}

void drawPingStats() {
  // img.fillRect(0, 195, 320, 20, BG_COLOR);
  img.setTextSize(1);
  // img.setTextColor(TEXT_DIM, BG_COLOR);
  img.setTextColor(TEXT_DIM);
  img.setCursor(10, 198);

  int avgPing = pingCount > 0 ? (pingSum / pingCount) : 0;

  if (currentPing < 0) {
    img.setTextColor(GRAPH_BAD, BG_COLOR);
    img.printf("PING: TIMEOUT   min:%d avg:%d max:%d ms", minPing, avgPing, maxPing);
    setLed(true, false, false);
  } else {
    img.printf("PING: %dms   min:%d avg:%d max:%d ms", currentPing, minPing, avgPing, maxPing);
    // setLed(false, currentPing < 80, currentPing >= 80); // зелений=добре, синій=повільно
  }
}

void drawSystemInfo() {
  // img.fillRect(0, 30, 320, 65, BG_COLOR);

  uint32_t freeHeap = ESP.getFreeHeap();
  uint32_t totalHeap = ESP.getHeapSize();
  int heapPercent = (freeHeap * 100) / totalHeap;

  uint32_t cpuFreq = ESP.getCpuFreqMHz();
  uint32_t uptimeSec = millis() / 1000;

  img.setTextSize(1);
  // img.setTextColor(TEXT_MAIN, BG_COLOR);
  img.setTextColor(TEXT_MAIN);
  img.setCursor(10, 32);
  img.printf("CPU: %d MHz   Loop rate: %d/s", cpuFreq, loopsPerSecond);

  img.setCursor(10, 44);
  img.printf("Heap free: %d KB / %d KB (%d%%)", freeHeap / 1024, totalHeap / 1024, heapPercent);

  // Візуальний бар пам'яті
  int barX = 10, barY = 56, barW = 300, barH = 10;
  img.drawRect(barX, barY, barW, barH, GRID_COLOR);
  int fillW = (heapPercent * (barW - 2)) / 100;
  uint16_t barColor = heapPercent > 30 ? TFT_GREEN : (heapPercent > 15 ? TFT_YELLOW : TFT_RED);
  img.fillRect(barX + 1, barY + 1, fillW, barH - 2, barColor);

  img.setCursor(10, 70);
  img.printf("Uptime: %02d:%02d:%02d", uptimeSec / 3600, (uptimeSec / 60) % 60, uptimeSec % 60);

  int lightPercent = readLightPercent();
  img.setCursor(180, 70);
  img.printf("Light: %d%%", lightPercent);
}

void drawTime() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) { 
    img.setTextSize(2);
    img.setTextColor(TFT_RED, TFT_BLACK);
    img.setCursor(tft.width() - 10 - img.textWidth("Time sync failed!"), 8);
    img.print("Time sync failed");
    Serial.println("Time sync failed!");
    return;
  }

  char timeStr[9];
  strftime(timeStr, sizeof(timeStr), "%H:%M:%S", &timeinfo);

  // img.fillRect(200, 5, 120, 20, BG_COLOR);
  img.setTextSize(2);
  // img.setTextColor(TEXT_MAIN, BG_COLOR);
  img.setTextColor(TEXT_MAIN);

  img.setCursor(tft.width() - 10 - img.textWidth(timeStr), 8);
  img.print(timeStr);
}

int lastLightPercent = -1;
uint8_t lightToBrightness(int lightPercent) {
  // Темно (0%) -> тьмяно (2), яскраво (100%) -> максимум (255)
  return map(lightPercent, 0, 100, 2, 180);
}

void updateAutoBrightness() {
  static uint32_t lastCheck = 0;
  if (millis() - lastCheck < 1000) return; // перевіряти раз на секунду
  lastCheck = millis();

  int lightPercent = readLightPercent();
  if (abs(lightPercent - lastLightPercent) > 5) { // оновлювати тільки при помітній зміні
    uint8_t brightness = lightToBrightness(lightPercent);
    setBrightness(brightness);
    lastLightPercent = lightPercent;
    Serial.printf("Light: %d%% -> Brightness: %d\n", lightPercent, brightness);
  }
}

static TouchScreenConfig makeMapperConfig() {
    TouchScreenConfig c;
    // Приклад: контролер видає сирі 0..4095, екран фізично 320x240,
    // а сама панель ще й повернута (типова ситуація для дешевих SPI TFT).
    // c.rawMinX = 200;  c.rawMaxX = 3900; // підбирається калібруванням
    // c.rawMinY = 200;  c.rawMaxY = 3900;
    c.screenWidth  = 320;
    c.screenHeight = 240;
    c.invertY = true;   // якщо вертикаль перевернута
    c.invertX = true;   // якщо горизонталь перевернута
    c.swapXY = false;  // якщо екран повернутий на 90/270 градусів

    return c;
}

static TouchEventsConfig makeTouchConfig() {
    TouchEventsConfig c;
    c.screenWidth  = 320;
    c.screenHeight = 240;
    // c.holdThresholdMs = 700;
    // c.dblClickIntervalMs = 300;
    // c.swipeMinDistancePx = 25;
    // c.swipeMaxDurationMs = 600;
    // c.edgeZonePx = 25;
    return c;
}

TouchScreenConfig touchScreenConfig = makeMapperConfig();
TouchPointMapper mapper(touchScreenConfig);
TouchEventsConfig touchEventsConfig = makeTouchConfig();
TouchEvents touch(touchEventsConfig);

void onTouchLog(TouchPoint p) { Serial.printf("Touch: %d, %d\n", p.x, p.y); }
void onHoldHandler(TouchPoint p, unsigned long ms)         { Serial.printf("Hold at %d,%d for %lu ms\n", p.x, p.y, ms); }
void onDblClickHandler(TouchPoint p)                       { Serial.printf("Double click: %d, %d\n", p.x, p.y); }
void onSwipeLeftHandler(TouchPoint start, TouchPoint end)  { Serial.println("Swipe LEFT"); }
void onSwipeRightHandler(TouchPoint start, TouchPoint end) { Serial.println("Swipe RIGHT"); }
void onSwipeUpHandler(TouchPoint start, TouchPoint end)    { Serial.println("Swipe UP"); }
void onSwipeDownHandler(TouchPoint start, TouchPoint end)  { Serial.println("Swipe DOWN"); }

void onSwipeFromBottomHandler(TouchPoint start, TouchPoint end) { Serial.println("Swipe FROM BOTTOM (напр., відкрити меню)"); }
void onSwipeFromTopHandler(TouchPoint start, TouchPoint end)    { Serial.println("Swipe FROM TOP (напр., шторка сповіщень)"); }
void onSwipeFromLeftHandler(TouchPoint start, TouchPoint end)   { Serial.println("Swipe FROM LEFT (напр., назад)"); }
void onSwipeFromRightHandler(TouchPoint start, TouchPoint end)  { Serial.println("Swipe FROM RIGHT (напр., бокова панель)"); }

void setupTouchPoint() {
    touch.setTouchPointMapper(&mapper);

    touch.onTouch(onTouchLog);
    touch.onHold(onHoldHandler);
    touch.onDblClick(onDblClickHandler);
    touch.onSwipeLeft(onSwipeLeftHandler);
    touch.onSwipeRight(onSwipeRightHandler);
    touch.onSwipeUp(onSwipeUpHandler);
    touch.onSwipeDown(onSwipeDownHandler);
    touch.onSwipeFromBottom(onSwipeFromBottomHandler);
    touch.onSwipeFromTop(onSwipeFromTopHandler);
    touch.onSwipeFromLeft(onSwipeFromLeftHandler);
    touch.onSwipeFromRight(onSwipeFromRightHandler);
}


void setup() {
  Serial.begin(115200);
  delay(500);

  setupLed();

  tft.init();
  tft.setRotation(3);
  tft.fillScreen(BG_COLOR);

  setupBacklight();
  setBrightness(200);
  
  img.setColorDepth(8);
  img.setSwapBytes(true);
  if (img.createSprite(tft.width(), tft.height()) == nullptr) {
    Serial.println("ERROR: Not enough RAM for img.createSprite!");
  } else {
    Serial.println("Success: img.createSprite()");
  }

  touchSPI.begin(25, 39, 32, TOUCH_CS);
  ts.begin(touchSPI);
  ts.setRotation(3);

  setupTouchPoint();
  setupWiFi(tft);
  configTime(gmtOffset_sec, daylightOffset_sec, ntpServer1, ntpServer2, ntpServer3);

  for (int i = 0; i < GRAPH_POINTS; i++) pingHistory[i] = -2; // -2 = ще немає даних

  // drawGraphFrame();
  lastLoopCheckMs = millis();

  if (!LittleFS.begin(true)) {
    Serial.println("LittleFS mount failed!");
  } else {
    Serial.println("LittleFS mounted successfully (done)");
  }

  delay(50);

  // --- Список усіх файлів ---
  File root = LittleFS.open("/");
  File file = root.openNextFile();
  while (file) {
    Serial.printf("File: %s, size: %d bytes\n", file.name(), file.size());
    file = root.openNextFile();
  }

  // --- Скільки місця залишилось ---
  Serial.printf("Used: %d / Total: %d bytes\n", LittleFS.usedBytes(), LittleFS.totalBytes());
}

void loop1() {
  // 1. Очищення віртуального буфера (замість img.fillScreen)
  img.fillSprite(TFT_BLACK);

  // 2. Малювання тексту та графіки у буфер
  img.setTextColor(TFT_WHITE);
  img.setTextSize(2);
  img.setCursor(10, 10);
  img.print("curent millis(): ");
  img.print(millis());

  img.drawRect(10, 50, 100, 50, TFT_RED); // Приклад геометричної фігури

  // 3. Відправка готового кадру на фізичний дисплей
  img.pushSprite(0, 0); 

  delay(16); // Приблизно 60 FPS
}

void dumpTemperatureValue() {
  static uint32_t lastDump = millis();
  if (millis() - lastDump >= PING_INTERVAL_MS) {
    Serial.printf("Temperature sensor value: %.2f °C\n", temperatureRead());
    lastDump = millis();
  }
}

int mapTouchX(int rawX) {
  return map(min(max(rawX, TOUCH_MIN_X), TOUCH_MAX_X), TOUCH_MAX_X, TOUCH_MIN_X, 0, 320);
}

int mapTouchY(int rawY) {
  return map(min(max(rawY, TOUCH_MIN_Y), TOUCH_MAX_Y), TOUCH_MAX_Y, TOUCH_MIN_Y, 0, 240);
}

void drawTouchPoint() {
  static uint32_t lastDump = millis();
  if (ts.touched()) {
    TS_Point p = ts.getPoint();
    static int minX = 4095, maxX = 0, minY = 4095, maxY = 0;
    if (p.x < minX) minX = p.x;
    if (p.x > maxX) maxX = p.x;
    if (p.y < minY) minY = p.y;
    if (p.y > maxY) maxY = p.y;
    TouchPoint p2 = mapper.map(p.x, p.y);

    img.drawCircle(p2.x, p2.y, 3, TFT_RED);
    img.fillCircle(p2.x, p2.y, 2, TFT_YELLOW);
    Serial.printf("raw(x=%4d y=%4d) | screen(x=%4d y=%4d) | map(x=%4d y=%4d) | bounds: X[%4d-%4d] Y[%4d-%4d]\n", p.x, p.y, mapTouchX(p.x), mapTouchY(p.y), p2.x, p2.y, minX, maxX, minY, maxY);
    lastDump = millis();
  }
}

void drawPoints() {
    img.drawRect(0, 0, 1, 1, TFT_WHITE);
    img.drawRect(tft.width()-1, 0, 1, 1, TFT_WHITE);
    img.drawRect(tft.width()-1, tft.height() - 1, 1, 1, TFT_WHITE);
    img.drawRect(0, tft.height() - 1, 1, 1, TFT_WHITE);
}

void loop() {
  touch.update(ts);
  loopCounter++;

  img.fillSprite(TFT_BLACK);
  updateAutoBrightness();
  // dumpTemperatureValue();

  uint32_t now = millis();

  // Підрахунок швидкості циклів loop() за секунду
  if (now - lastLoopCheckMs >= 1000) {
    loopsPerSecond = loopCounter;
    loopCounter = 0;
    lastLoopCheckMs = now;
  }

  if (now - lastPingMs >= PING_INTERVAL_MS) {
    lastPingMs = now;
    doPing();
  }

  // loopLedGradient();
  drawBackground();

  img.drawRect(
    touchEventsConfig.edgeZonePx, touchEventsConfig.edgeZonePx,
    touchEventsConfig.screenWidth - 2 * touchEventsConfig.edgeZonePx, touchEventsConfig.screenHeight - 2 * touchEventsConfig.edgeZonePx,
    TFT_DARKGREY
  );

  drawPoints();
  drawGraphFrame();
  drawPingGraph();
  drawPingStats();
  
  drawTime();
  drawSystemInfo();
  drawTouchPoint();

  img.pushSprite(0, 0); 
  delay(16);
}
