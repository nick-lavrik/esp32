{
  "name": "HttpServer",
  "version": "0.1.0",
  "description": "Async HTTP server wrapper: pluggable static sources (LittleFS/SD/PROGMEM/callback), EventDispatcher integration",
  "keywords": ["esp32", "esp8266", "webserver", "async", "littlefs", "sd"],
  "frameworks": ["arduino"],
  "platforms": ["espressif32", "espressif8266"],
  "dependencies": [
    {
      "owner": "mathieucarbou",
      "name": "ESPAsyncWebServer",
      "version": "^3.6.0",
      "platforms": ["espressif32", "espressif8266"]
    },
    {
      "owner": "mathieucarbou",
      "name": "AsyncTCP",
      "version": "^3.3.2",
      "platforms": "espressif32"
    },
    {
      "owner": "esphome",
      "name": "ESPAsyncTCP-esphome",
      "version": "^2.0.0",
      "platforms": "espressif8266"
    },
    {
      "name": "Hash",
      "platforms": "espressif8266"
    }
  ],
  "build": {
    "flags": [
      "-std=gnu++17"
    ]
  },
  "export": {
    "include": [
      "*.hpp",
      "*.cpp",
      "library.json"
    ]
  }
}
