{
  "name": "SDRawReader",
  "version": "0.1.0",
  "description": "Raw sector reader and ext4 superblock inspector for SD cards",
  "keywords": ["esp32", "sd", "sdcard", "raw", "ext4", "recovery"],
  "frameworks": ["espidf", "arduino"],
  "platforms": ["espressif32"],
  "build": {
    "flags": [
      "-std=gnu++17"
    ]
  },
  "export": {
    "include": [
      "*.hpp",
      "*.cpp",
      "library.json"
    ]
  }
}
